# Supabase - obtener de: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...TU_ANON_KEY_AQUI

# EmailJS - obtener de: emailjs.com → Dashboard
